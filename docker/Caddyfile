{
	admin off
	# Keep X-Forwarded-Proto/-For from proxies on private networks (the Cloudflare tunnel
	# container), so the app knows a visitor came in over https and who they are.
	servers {
		trusted_proxies static private_ranges
	}
}

# SITE_ADDRESS defaults to ":80" (plain HTTP behind HTTP_PORT).
# Set it to a domain name and Caddy fetches and renews an HTTPS certificate automatically.
{$SITE_ADDRESS::80} {
	encode zstd gzip
	reverse_proxy app:3000
}
