# Copy to .env, or run ./scripts/init-env.sh to generate one with random secrets.

# Database password (used by the postgres, app and worker containers).
POSTGRES_PASSWORD=change-me

# Secret used to encrypt channel tokens. 32+ random characters. Never change it after setup.
APP_SECRET=change-me-to-32-or-more-random-characters

# Port on this machine that serves the app.
HTTP_PORT=8110

# The address people (and Meta's webhooks) use to reach this install.
PUBLIC_URL=http://localhost:8110

# What Caddy listens for. ":80" = plain HTTP behind the port above.
# Set to your domain (e.g. social.example.com) for automatic HTTPS, and publish ports 80 + 443.
SITE_ADDRESS=:80

# Time zone for scheduled jobs such as nightly backups.
TZ=UTC

# Meta app secret (App settings > Basic in the Meta developer dashboard). Needed for the
# data-deletion callback now and Instagram webhooks in Phase 2.
META_APP_SECRET=

# Optional: an email address shown on the public privacy page (/privacy).
PRIVACY_CONTACT=

# Optional: Cloudflare Tunnel token. Start with: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Development machines only: also load the dev override (exposes Postgres on 127.0.0.1:55432).
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
